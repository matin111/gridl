from __future__ import annotations

import hashlib
import hmac
import html
import os
import secrets
import sqlite3
import time
import urllib.parse
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

from fastapi import APIRouter, Request
from fastapi.responses import HTMLResponse, RedirectResponse

from subscription_admin_api import (
    DATABASE_PATH,
    database,
    get_or_create_user,
    isoformat,
    user_subscription_snapshot,
    utc_now,
)


SESSION_COOKIE = "aistudio_admin_session"
SESSION_MAX_AGE_SECONDS = 60 * 60 * 12


def panel_password() -> str:
    return os.getenv(
        "ADMIN_PANEL_PASSWORD",
        "",
    ).strip()


def session_secret() -> str:
    return os.getenv(
        "ADMIN_PANEL_SESSION_SECRET",
        "",
    ).strip()


def create_session_token() -> str:
    timestamp = str(int(time.time()))

    signature = hmac.new(
        session_secret().encode("utf-8"),
        timestamp.encode("utf-8"),
        hashlib.sha256,
    ).hexdigest()

    return f"{timestamp}.{signature}"


def valid_session_token(
    token: str | None,
) -> bool:
    if not token:
        return False

    if not session_secret():
        return False

    try:
        timestamp_text, signature = token.split(
            ".",
            1,
        )

        timestamp = int(timestamp_text)

    except (ValueError, TypeError):
        return False

    if (
        int(time.time()) - timestamp
        > SESSION_MAX_AGE_SECONDS
    ):
        return False

    expected = hmac.new(
        session_secret().encode("utf-8"),
        timestamp_text.encode("utf-8"),
        hashlib.sha256,
    ).hexdigest()

    return hmac.compare_digest(
        signature,
        expected,
    )


def is_authenticated(
    request: Request,
) -> bool:
    return valid_session_token(
        request.cookies.get(
            SESSION_COOKIE
        )
    )


def require_auth(
    request: Request,
):
    if not is_authenticated(request):
        return RedirectResponse(
            url="/admin/login",
            status_code=303,
        )

    return None


async def read_form(
    request: Request,
) -> dict[str, str]:
    body = await request.body()

    parsed = urllib.parse.parse_qs(
        body.decode(
            "utf-8",
            errors="ignore",
        )
    )

    return {
        key: values[-1]
        for key, values in parsed.items()
        if values
    }


def esc(value) -> str:
    return html.escape(
        str(value or "")
    )


def active_count() -> int:
    now = isoformat(utc_now())

    with database() as connection:
        row = connection.execute(
            """
            SELECT COUNT(*) AS total
            FROM subscriptions
            WHERE is_active = 1
              AND (
                    expires_at IS NULL
                    OR expires_at > ?
                  )
            """,
            (now,),
        ).fetchone()

    return int(row["total"])


def user_count() -> int:
    with database() as connection:
        row = connection.execute(
            """
            SELECT COUNT(*) AS total
            FROM users
            """
        ).fetchone()

    return int(row["total"])


def campaign_count() -> int:
    now = isoformat(utc_now())

    with database() as connection:
        row = connection.execute(
            """
            SELECT COUNT(*) AS total
            FROM campaigns
            WHERE enabled = 1
              AND starts_at <= ?
              AND ends_at > ?
            """,
            (
                now,
                now,
            ),
        ).fetchone()

    return int(row["total"])


def notification_count() -> int:
    with database() as connection:
        row = connection.execute(
            """
            SELECT COUNT(*) AS total
            FROM notifications
            """
        ).fetchone()

    return int(row["total"])



def dashboard_metrics() -> dict[str, int]:
    now = utc_now()
    now_text = isoformat(now)
    today_text = isoformat(now.replace(hour=0, minute=0, second=0, microsecond=0))
    online_since = isoformat(now - timedelta(minutes=15))

    with database() as connection:
        row = connection.execute(
            """
            SELECT
                (SELECT COUNT(*) FROM users) AS total_users,
                (SELECT COUNT(*) FROM users WHERE last_seen_at >= ?) AS online_users,
                (SELECT COUNT(*) FROM users WHERE created_at >= ?) AS new_users_today,
                (SELECT COUNT(*) FROM users WHERE is_blocked = 1) AS blocked_users,
                (SELECT COUNT(*) FROM subscriptions
                  WHERE is_active = 1
                    AND (expires_at IS NULL OR expires_at > ?)) AS premium_users,
                (SELECT COUNT(*) FROM usage_events WHERE created_at >= ?) AS usage_today,
                (SELECT COUNT(*) FROM campaigns
                  WHERE enabled = 1 AND starts_at <= ? AND ends_at > ?) AS active_campaigns,
                (SELECT COUNT(*) FROM notifications WHERE enabled = 1) AS enabled_notifications
            """,
            (online_since, today_text, now_text, today_text, now_text, now_text),
        ).fetchone()

    total = int(row["total_users"] or 0)
    premium = int(row["premium_users"] or 0)
    return {
        "total_users": total,
        "online_users": int(row["online_users"] or 0),
        "new_users_today": int(row["new_users_today"] or 0),
        "blocked_users": int(row["blocked_users"] or 0),
        "premium_users": premium,
        "free_users": max(total - premium, 0),
        "usage_today": int(row["usage_today"] or 0),
        "active_campaigns": int(row["active_campaigns"] or 0),
        "enabled_notifications": int(row["enabled_notifications"] or 0),
    }


def dashboard_daily_series(days: int = 7) -> list[dict[str, int | str]]:
    today = utc_now().replace(hour=0, minute=0, second=0, microsecond=0)
    start = today - timedelta(days=days - 1)

    with database() as connection:
        user_rows = connection.execute(
            """
            SELECT substr(created_at, 1, 10) AS day, COUNT(*) AS total
            FROM users
            WHERE created_at >= ?
            GROUP BY substr(created_at, 1, 10)
            """,
            (isoformat(start),),
        ).fetchall()
        usage_rows = connection.execute(
            """
            SELECT substr(created_at, 1, 10) AS day, COUNT(*) AS total
            FROM usage_events
            WHERE created_at >= ?
            GROUP BY substr(created_at, 1, 10)
            """,
            (isoformat(start),),
        ).fetchall()

    users_by_day = {row["day"]: int(row["total"] or 0) for row in user_rows}
    usage_by_day = {row["day"]: int(row["total"] or 0) for row in usage_rows}
    result = []
    for offset in range(days):
        current = start + timedelta(days=offset)
        key = current.date().isoformat()
        result.append({
            "day": key,
            "label": current.strftime("%m/%d"),
            "users": users_by_day.get(key, 0),
            "usage": usage_by_day.get(key, 0),
        })
    return result


def dashboard_recent_activity(limit: int = 8) -> list[sqlite3.Row]:
    with database() as connection:
        return connection.execute(
            """
            SELECT ue.feature_key, ue.event_type, ue.created_at,
                   COALESCE(u.display_name, u.phone, u.email, ue.installation_id) AS user_title
            FROM usage_events ue
            LEFT JOIN users u ON u.installation_id = ue.installation_id
            ORDER BY ue.created_at DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()

