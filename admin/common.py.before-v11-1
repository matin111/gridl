id-template-columns:repeat(2,1fr)}.users-summary{grid-template-columns:repeat(3,1fr)}.user-card,.user-card-v3{grid-template-columns:1fr 1fr}}@media(max-width:960px){.shell{grid-template-columns:1fr}.sidebar{position:relative;height:auto;padding:14px}.brand{padding-bottom:10px}.nav{display:flex;overflow:auto;padding-bottom:4px}.nav a{white-space:nowrap}.content{padding:18px}.dashboard-main,.split{grid-template-columns:1fr}}@media(max-width:640px){.content{padding:14px}.topbar{align-items:flex-start}.page-heading h1{font-size:21px}.grid,.dashboard-grid,.kpi-row,.form-grid,.quick-grid,.users-summary,.detail-grid,.usage-grid{grid-template-columns:1fr}.chart{gap:3px}.chart-bar{width:10px}.feature-row{grid-template-columns:1fr}.user-card,.user-card-v3{grid-template-columns:1fr}.users-toolbar{grid-template-columns:1fr}}

/* Admin Panel 3.0: collapsible sidebar */
:root{--sidebar-width:276px}
.shell{grid-template-columns:var(--sidebar-width) minmax(0,1fr);transition:grid-template-columns .25s ease}
body.sidebar-collapsed{--sidebar-width:86px}
.sidebar{transition:width .25s ease,padding .25s ease}
.nav-label,.brand-label,.manager-copy,.sidebar-footer{transition:opacity .18s ease,width .18s ease}
.nav-icon{width:26px;min-width:26px;text-align:center;font-size:16px}
.sidebar-toggle{width:40px;height:40px;border:1px solid var(--border);border-radius:12px;background:var(--card);color:var(--text);display:grid;place-items:center;font-weight:900}
.page-title-wrap{display:flex;align-items:center;gap:12px}
body.sidebar-collapsed .nav-label,body.sidebar-collapsed .brand-label,body.sidebar-collapsed .manager-copy,body.sidebar-collapsed .sidebar-footer{display:none}
body.sidebar-collapsed .brand,body.sidebar-collapsed .nav a,body.sidebar-collapsed .manager-card{justify-content:center}
body.sidebar-collapsed .nav a{padding-inline:10px}
@media(max-width:960px){.sidebar{position:fixed!important;right:0;top:0;width:276px;height:100vh!important;transform:translateX(110%);transition:transform .25s ease;z-index:1001}.shell{grid-template-columns:1fr!important}body.mobile-sidebar-open .sidebar{transform:translateX(0)}.mobile-overlay{display:block!important}}
.mobile-overlay{display:none;position:fixed;inset:0;background:rgba(12,9,28,.55);z-index:1000;opacity:0;pointer-events:none;transition:.2s}body.mobile-sidebar-open .mobile-overlay{opacity:1;pointer-events:auto}

/* Admin Panel 3.1 fixes: sidebar and users */
.brand{white-space:nowrap;overflow:hidden}
.brand-mark{width:42px;height:42px;min-width:42px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#9b7cff,#6c3cff);box-shadow:0 10px 24px rgba(108,60,255,.35);font-weight:950}
.manager-card{overflow:hidden;white-space:nowrap}
body.sidebar-collapsed{--sidebar-width:76px}
body.sidebar-collapsed .sidebar{padding-inline:10px}
body.sidebar-collapsed .brand{padding-inline:7px}
body.sidebar-collapsed .brand-mark{width:42px;min-width:42px}
body.sidebar-collapsed .nav a{width:52px;height:48px;margin-inline:auto;padding:0;justify-content:center;transform:none}
body.sidebar-collapsed .nav a:hover,body.sidebar-collapsed .nav a.active{transform:none}
body.sidebar-collapsed .nav a.active{box-shadow:inset -3px 0 #a88fff}
body.sidebar-collapsed .manager-card{width:52px;height:52px;margin-inline:auto!important;padding:0!important;justify-content:center}
body.sidebar-collapsed .brand-label,body.sidebar-collapsed .nav-label,body.sidebar-collapsed .manager-copy,body.sidebar-collapsed .sidebar-footer{display:none!important}
.users-hero{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px;padding:4px 2px}
.users-hero h2{margin:0;font-size:24px}
.users-hero p{margin:5px 0 0;color:var(--muted);font-size:12px}
.search-wrap{position:relative}
.search-wrap input{padding-right:40px;padding-left:38px}
.search-icon{position:absolute;right:13px;bottom:12px;pointer-events:none}
.clear-search{position:absolute;left:7px;bottom:7px;width:30px;height:30px;border:0;border-radius:9px;background:var(--card-2);color:var(--muted)}
.users-summary{grid-template-columns:repeat(5,minmax(0,1fr));margin-top:14px}
.mini-stat{min-height:104px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}
.stat-icon{font-size:18px;margin-bottom:5px}
.user-card-v3{grid-template-columns:minmax(260px,1.3fr) minmax(250px,1fr) minmax(220px,.9fr) minmax(150px,auto);padding:16px 18px;overflow:visible}
.avatar-wrap{position:relative;flex:0 0 auto}
.avatar-ring{padding:3px;border-radius:18px;background:linear-gradient(135deg,#dcd2ff,#7a54f7)}
.presence-dot{position:absolute;left:-2px;bottom:-2px;width:12px;height:12px;border-radius:50%;border:2px solid var(--card)}
.presence-dot.online{background:#20bf7b}.presence-dot.offline{background:#a7a7b7}.presence-dot.blocked{background:#ef476f}
.user-badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
.info-stack{display:grid;gap:7px;min-width:0}
.info-row{display:grid;grid-template-columns:78px minmax(0,1fr);gap:8px;align-items:start;font-size:11px}
.info-row b{color:var(--muted);font-weight:800}
.info-row span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;direction:auto}
.usage-strip{display:grid;grid-template-columns:repeat(3,minmax(58px,1fr));gap:7px}
.usage-chip{padding:9px 7px;text-align:center;border:1px solid var(--border);border-radius:12px;background:var(--card-2)}
.usage-chip strong{display:block;font-size:18px;line-height:1.2}
.usage-chip span{display:block;color:var(--muted);font-size:9px;margin-top:3px}
.user-actions{min-width:140px;justify-content:flex-start;align-items:stretch}
.user-actions form{margin:0}
.user-actions .btn{width:100%;white-space:nowrap}
.more-menu{position:relative}
.more-menu summary{list-style:none;width:38px;height:36px;display:grid;place-items:center;border:1px solid var(--border);border-radius:10px;background:var(--card-2);cursor:pointer;font-size:20px}
.more-menu summary::-webkit-details-marker{display:none}
.more-pop{position:absolute;left:0;top:43px;z-index:50;min-width:155px;padding:7px;border:1px solid var(--border);border-radius:13px;background:var(--card);box-shadow:var(--shadow)}
.more-pop a,.more-pop button{display:block;width:100%;padding:9px 10px;border:0;border-radius:9px;background:transparent;text-align:right;color:var(--text);font-size:11px}
.more-pop a:hover,.more-pop button:hover{background:var(--primary-soft)}
.drawer-head{position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;padding:18px;border-bottom:1px solid var(--border);background:var(--card);z-index:2}
.drawer-close{width:36px;height:36px;border:0;border-radius:10px;background:var(--card-2);font-size:22px}
.drawer-body{padding:18px}
.drawer-profile{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.drawer-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.drawer-item{padding:12px;border:1px solid var(--border);border-radius:13px;background:var(--card-2)}
.drawer-item small{display:block;color:var(--muted);margin-bottom:5px}
.drawer-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.drawer-actions form,.drawer-actions .btn{width:100%;margin:0}
@media(max-width:1260px){.user-card-v3{grid-template-columns:1fr 1fr}.user-actions{justify-content:flex-start}}
@media(max-width:960px){body.sidebar-collapsed{--sidebar-width:276px}.sidebar{width:276px!important;padding:14px 16px!important}body.sidebar-collapsed .brand-label,body.sidebar-collapsed .nav-label,body.sidebar-collapsed .manager-copy,body.sidebar-collapsed .sidebar-footer{display:initial!important}body.sidebar-collapsed .nav a{width:auto;height:auto;margin:0;padding:12px 13px;justify-content:flex-start}}
@media(max-width:700px){.users-hero{align-items:flex-start}.users-summary{grid-template-columns:repeat(2,1fr)}.user-card-v3{grid-template-columns:1fr}.users-toolbar{grid-template-columns:1fr}.drawer-grid,.drawer-actions{grid-template-columns:1fr}}


/* Admin Panel 3.3: professional desktop icon rail */
@media(min-width:961px){
  .shell{grid-template-columns:276px minmax(0,1fr);transition:grid-template-columns .26s ease}
  .sidebar{width:276px;min-width:276px;transform:none;opacity:1;pointer-events:auto;overflow-x:hidden;transition:width .26s ease,min-width .26s ease,padding .26s ease}
  body.sidebar-collapsed .shell{grid-template-columns:88px minmax(0,1fr)}
  body.sidebar-collapsed .sidebar{width:88px;min-width:88px;padding:18px 12px}
  body.sidebar-collapsed .brand{padding:6px 0 18px;justify-content:center}
  body.sidebar-collapsed .brand-mark{width:46px;height:46px;min-width:46px}
  body.sidebar-collapsed .brand-label,
  body.sidebar-collapsed .manager-copy,
  body.sidebar-collapsed .sidebar-footer{display:none!important}
  body.sidebar-collapsed .manager-card{width:52px;height:52px;margin:0 auto 14px!important;padding:0!important;justify-content:center}
  body.sidebar-collapsed .nav{gap:8px}
  body.sidebar-collapsed .nav a{position:relative;width:56px;height:50px;margin:0 auto;padding:0;justify-content:center;border-radius:15px;transform:none}
  body.sidebar-collapsed .nav a:hover,body.sidebar-collapsed .nav a.active{transform:none}
  body.sidebar-collapsed .nav a.active{background:linear-gradient(135deg,rgba(150,121,255,.34),rgba(255,255,255,.12));box-shadow:inset -3px 0 #b7a2ff,0 8px 20px rgba(0,0,0,.14)}
  body.sidebar-collapsed .nav-label{display:none!important}
  body.sidebar-collapsed .nav-icon{font-size:19px;line-height:1}
  body.sidebar-collapsed .nav a::after{content:attr(data-label);position:absolute;right:66px;top:50%;transform:translateY(-50%) translateX(8px);white-space:nowrap;padding:8px 10px;border-radius:10px;background:#171329;color:#fff;font-size:11px;font-weight:800;opacity:0;pointer-events:none;transition:.16s;box-shadow:0 10px 28px rgba(0,0,0,.22);z-index:80}
  body.sidebar-collapsed .nav a:hover::after{opacity:1;transform:translateY(-50%) translateX(0)}
  body.sidebar-collapsed .content{padding-inline:28px}
  body.sidebar-collapsed .sidebar-toggle{background:var(--primary);border-color:var(--primary);color:#fff}
}



/* Admin Panel 3.4: single-color active navigation */
.nav a:hover{background:rgba(255,255,255,.08);box-shadow:none}
.nav a.active,.nav a.active:hover,.nav a.active:focus,.nav a.active:focus-visible{
  color:#fff!important;
  background:#5f3bd6!important;
  box-shadow:none!important;
  outline:none!important;
  transform:none!important;
}
body.sidebar-collapsed .nav a.active,
body.sidebar-collapsed .nav a.active:hover,
body.sidebar-collapsed .nav a.active:focus,
body.sidebar-collapsed .nav a.active:focus-visible{
  background:#5f3bd6!important;
  box-shadow:none!important;
  outline:none!important;
}
.sidebar-toggle:focus,.sidebar-toggle:focus-visible,.nav a:focus,.nav a:focus-visible{outline:none;box-shadow:none}
</style>
</head>
<body>
<div class="mobile-overlay" onclick="closeSidebar()"></div>
<div class="shell">
<aside class="sidebar">
  <div class="brand"><span class="brand-mark">ر</span><span class="brand-label">مدیریت رشد یار</span></div><div class="manager-card" style="margin:0 8px 14px;padding:11px;border:1px solid rgba(255,255,255,.11);border-radius:14px;background:rgba(255,255,255,.06);display:flex;gap:10px;align-items:center"><span class="nav-icon">م</span><div class="manager-copy"><div style="font-size:11px;font-weight:900">مدیر سیستم</div><div style="font-size:9px;color:#79e7b4;margin-top:3px">● سامانه آنلاین</div></div></div>
  <nav class="nav">
    <a data-path="/admin" data-label="داشبورد" href="/admin"><span class="nav-icon">⌂</span><span class="nav-label">داشبورد</span></a>
    <a data-path="/admin/users" data-label="کاربران و اشتراک‌ها" href="/admin/users"><span class="nav-icon">👥</span><span class="nav-label">کاربران و اشتراک‌ها</span></a>
    <a data-path="/admin/campaigns" data-label="کمپین‌ها و بنرها" href="/admin/campaigns"><span class="nav-icon">🎯</span><span class="nav-label">کمپین‌ها و بنرها</span></a>
    <a data-path="/admin/notifications" data-label="اعلان‌ها" href="/admin/notifications"><span class="nav-icon">🔔</span><span class="nav-label">اعلان‌ها</span></a>
    <a data-path="/admin/support" data-label="پشتیبانی کاربران" href="/admin/support"><span class="nav-icon">💬</span><span class="nav-label">پشتیبانی کاربران</span></a>
    <a data-path="/admin/analytics" data-label="آمار و گزارش‌ها" href="/admin/analytics"><span class="nav-icon">📊</span><span class="nav-label">آمار و گزارش‌ها</span></a>
    <a data-path="/admin/features" data-label="مدیریت قابلیت‌ها" href="/admin/features"><span class="nav-icon">🧩</span><span class="nav-label">مدیریت قابلیت‌ها</span></a>
    <a data-path="/admin/landing" data-label="صفحه معرفی" href="/admin/landing"><span class="nav-icon">🌐</span><span class="nav-label">صفحه معرفی</span></a>
    <a data-path="/admin/plans" data-label="پلن‌های فروش" href="/admin/plans"><span class="nav-icon">💳</span><span class="nav-label">پلن‌های فروش</span></a>
    <a data-path="/admin/contact-messages" data-label="پیام‌های سایت" href="/admin/contact-messages"><span class="nav-icon">✉️</span><span class="nav-label">پیام‌های سایت</span></a>
    <a data-path="/admin/settings" data-label="نسخه و تنظیمات" href="/admin/settings"><span class="nav-icon">⚙️</span><span class="nav-label">نسخه و تنظیمات</span></a>
    <a data-path="/admin/releases" data-label="مرکز انتشار" href="/admin/releases"><span class="nav-icon">🚀</span><span class="nav-label">مرکز انتشار</span></a>
    <a data-label="خروج امن" href="/admin/logout"><span class="nav-icon">↪</span><span class="nav-label">خروج امن</span></a>
  </nav>
  <div class="sidebar-footer">نسخه پنل ۴.۳<br>مرکز مدیریت کاربران، سهمیه‌ها، محتوا و عملکرد سرویس</div>
</aside>
<main class="content">
  <div class="topbar">
    <div class="page-title-wrap"><button class="sidebar-toggle" type="button" onclick="toggleSidebar()">☰</button><div class="page-heading"><h1>__ADMIN_TITLE__</h1><p id="todayLabel">مرکز کنترل رشد یار</p></div></div>
    <div class="actions"><span class="badge badge-active">● API و دیتابیس فعال</span><button class="theme-btn" type="button" onclick="location.reload()" aria-label="بروزرسانی">↻</button><button class="theme-btn" type="button" onclick="toggleTheme()" aria-label="تغییر پوسته">◐</button></div>
  </div>
  __ADMIN_BODY__
</main>
</div>
<script>
(function(){if(localStorage.getItem('admin-theme')==='dark')document.body.classList.add('dark');if(localStorage.getItem('admin-sidebar')==='collapsed'&&innerWidth>960)document.body.classList.add('sidebar-collapsed');const p=location.pathname;document.querySelectorAll('.nav a[data-path]').forEach(a=>{const x=a.dataset.path;a.classList.toggle('active',x==='/admin'?p==='/admin':p.startsWith(x));});try{document.getElementById('todayLabel').textContent=new Intl.DateTimeFormat('fa-IR',{dateStyle:'full'}).format(new Date());}catch(e){}})();
function toggleTheme(){document.body.classList.toggle('dark');localStorage.setItem('admin-theme',document.body.classList.contains('dark')?'dark':'light')}
function toggleSidebar(){if(innerWidth<=960){document.body.classList.toggle('mobile-sidebar-open')}else{document.body.classList.toggle('sidebar-collapsed');localStorage.setItem('admin-sidebar',document.body.classList.contains('sidebar-collapsed')?'collapsed':'open')}}
function closeSidebar(){document.body.classList.remove('mobile-sidebar-open')}
</script>
</body></html>'''
    return (
        template
        .replace("__ADMIN_TITLE__", esc(title))
        .replace("__ADMIN_BODY__", body)
    )
