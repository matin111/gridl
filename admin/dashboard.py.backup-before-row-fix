SUCCESS_EVENT_TYPES = {"use", "success", "generated"}


def _safe_int(value: object, default: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def _metric(metrics: dict, key: str) -> int:
    return _safe_int(metrics.get(key, 0))


def _build_chart(series: list[dict]) -> str:
    if not series:
        return '<div class="notice">هنوز داده‌ای برای نمودار ثبت نشده است.</div>'

    max_users = max([_safe_int(item.get("users")) for item in series] + [1])
    max_usage = max([_safe_int(item.get("usage")) for item in series] + [1])

    columns: list[str] = []

    for item in series:
        users = _safe_int(item.get("users"))
        usage = _safe_int(item.get("usage"))
        label = esc(str(item.get("label", "-")))

        user_height = max(4, round(users / max_users * 160))
        usage_height = max(4, round(usage / max_usage * 160))

        columns.append(
            f"""
            <div class="chart-column" title="کاربر جدید: {users} | استفاده: {usage}">
              <div class="chart-bars">
                <div class="chart-bar users" style="height:{user_height}px"></div>
                <div class="chart-bar usage" style="height:{usage_height}px"></div>
              </div>
              <div class="chart-label">{label}</div>
            </div>
            """
        )

    return "".join(columns)


def _build_recent_activity(recent: list[dict]) -> str:
    if not recent:
        return '<div class="notice">هنوز رویدادی ثبت نشده است.</div>'

    items: list[str] = []

    for event in recent:
        feature_key = str(event.get("feature_key", ""))
        feature = FEATURE_TITLES.get(feature_key, feature_key or "قابلیت نامشخص")

        event_type = str(event.get("event_type", ""))
        event_title = "استفاده از" if event_type in SUCCESS_EVENT_TYPES else (event_type or "رویداد")

        user_title = esc(str(event.get("user_title", "کاربر ناشناس")))
        created_at = esc(str(event.get("created_at", "-")))

        items.append(
            f"""
            <div class="activity-item">
              <span class="activity-dot"></span>
              <div>
                <div class="activity-title">{user_title} — {esc(event_title)} {esc(feature)}</div>
                <div class="activity-meta">{created_at}</div>
              </div>
            </div>
            """
        )

    return "".join(items)


