@router.post("/settings/save")
async def save_settings(request: Request):
    redirect = require_auth(request)
    if redirect:
        return redirect

    try:
        form = await read_form(request)


        values = {
            "apk_url": (form.get("apk_url", "") or "").strip(),
            "market_url": (form.get("market_url", "") or "").strip(),
            "google_play_url": (form.get("google_play_url", "") or "").strip(),
        }

        now = isoformat(utc_now())

        with database() as connection:
            for key, value in values.items():
                connection.execute(
                    """
                    INSERT INTO app_settings(key, value, updated_at)
                    VALUES(?, ?, ?)
                    ON CONFLICT(key)
                    DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at
                    """,
                    (key, value, now),
                )

            stored_rows = connection.execute(
                "SELECT key, value FROM app_settings WHERE key IN (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                tuple(values.keys()),
            ).fetchall()
            stored_values = {row["key"]: row["value"] for row in stored_rows}

            mismatches = [
                key for key, expected_value in values.items()
                if stored_values.get(key) != expected_value
            ]
            if mismatches:
                raise RuntimeError(
                    "تأیید انتشار ناموفق بود؛ مقادیر زیر درست ثبت نشدند: "
                    + "، ".join(mismatches)
                )

        release_type = "اجباری" if values["force_update"] == "1" else "اختیاری"
        success_message = (
            f"تنظیمات با موفقیت ذخیره و منتشر شد؛ نسخه {latest_version_code} "
            f"با حالت {release_type} اکنون از API قابل دریافت است."
        )
        return RedirectResponse(
            url=f"/admin/settings?status=success&message={quote(success_message)}",
            status_code=303,
        )

    except ValueError as exc:
        return RedirectResponse(
            url=f"/admin/settings?status=error&message={quote(str(exc))}",
            status_code=303,
        )
    except Exception as exc:
        error_message = f"ذخیره یا انتشار تنظیمات ناموفق بود: {exc}"
        return RedirectResponse(
            url=f"/admin/settings?status=error&message={quote(error_message)}",
            status_code=303,
        )
