def _query_message(request: Request) -> tuple[str, str]:
    status = (request.query_params.get("status") or "").strip().lower()
    message = (request.query_params.get("message") or "").strip()
    if status not in {"success", "error"}:
        return "", ""
    if not message:
        message = "تنظیمات با موفقیت ذخیره و منتشر شد." if status == "success" else "ذخیره تنظیمات انجام نشد."
    return status, message


